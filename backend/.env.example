# =============================================================================
# Backend Environment Variables
# Copy this file to .env and fill in real values for local development.
# Production values are set in Vercel → backend project → Environment Variables.
# Never commit .env to git.
# =============================================================================

# Server
NODE_ENV=development
PORT=4000

# MongoDB Atlas
# Get from: MongoDB Atlas → Database → Connect → Drivers
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/your-database

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-min-64-chars

# Stripe
# Secret key: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Webhook secret: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# AWS S3 (image uploads)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=your-s3-bucket-name

# Upstash Redis (rate limiting)
# Dashboard: https://console.upstash.com
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# CORS — comma-separated list of allowed frontend origins (no spaces, no trailing slashes)
# Production example: https://your-admin.vercel.app,https://your-frontend.vercel.app
# Local development: localhost ports are always allowed automatically when NODE_ENV != production
CORS_ALLOWED_ORIGINS=https://your-admin.vercel.app,https://your-frontend.vercel.app

# Frontend URL — used by Stripe to redirect after payment
FRONTEND_URL=https://your-frontend.vercel.app

# Sentry (error tracking) — optional, errors only reported when set
# Get from: Sentry → Settings → Projects → Client Keys (DSN)
SENTRY_DSN=https://your-key@your-org.ingest.us.sentry.io/your-project-id
