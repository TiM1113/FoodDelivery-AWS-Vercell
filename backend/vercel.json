{
    "installCommand": "cd .. && pnpm install --frozen-lockfile",
    "buildCommand": "pnpm build",
    "functions": {
        "api/index.js": {
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api/index.js"
        }
    ]
}
