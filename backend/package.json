{
  "name": "@food-delivery/backend",
  "version": "3.0.0",
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "dev": "tsx watch serve.ts",
    "start": "tsx serve.ts",
    "build": "esbuild api/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" && rm -f api/index.ts",
    "vercel-build": "pnpm build",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "author": "Tim1113",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1017.0",
    "@aws-sdk/s3-request-presigner": "^3.1017.0",
    "@hono/node-server": "^1.14.1",
    "@neondatabase/serverless": "^1.0.2",
    "@sentry/node": "^10.46.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.9",
    "jsonwebtoken": "^9.0.2",
    "stripe": "^17.3.1",
    "validator": "^13.12.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/validator": "^13.12.2",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.27.4",
    "tsx": "^4.19.4",
    "typescript": "^5.9.3"
  }
}
