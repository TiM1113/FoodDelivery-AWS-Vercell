dev-notes/

# Screenshots and documentation files that should not be tracked
errorscreenshorts/
*.png
*.jpg
*.jpeg
*.gif

# Allow production image assets in apps/web
!apps/web/public/images/**/*.png

# Documentation files (keep only essential ones)
CLAUDE.md
DEPLOYMENT_GUIDE.md
DEPLOYMENT_SCRIPTS.md
OPTIMIZATION_GUIDE.md
TEST_DEPLOYMENT.md

# Node modules
node_modules/
*/node_modules/
packages/*/node_modules/

# pnpm
pnpm-debug.log*

# Build directories
dist/
build/
*/dist/
*/build/

# Environment files
.env
.env.local
.env.production

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Temporary files
tmp/
temp/

# Claude + Codex test artifacts (live in backend/__tests__/)
backend/__tests__/TEST-SPEC.md
backend/__tests__/TEST-REPORT.md

# Playwright auth state and test results
apps/web/e2e/.auth-state*.json
apps/web/e2e/.admin-auth-state.json
apps/web/test-results/
