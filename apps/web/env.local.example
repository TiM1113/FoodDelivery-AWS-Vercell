# NextAuth.js
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Server-only API URL (used by NextAuth authorize, never exposed to browser)
# Local: http://localhost:4000
# Production: https://backend-ten-azure-58.vercel.app
API_URL=

# Client-accessible API URL (used by browser-side fetches)
# Same value as API_URL in most cases
NEXT_PUBLIC_API_URL=
