# =============================================================================
# Frontend Environment Variables (Vite)
# These are baked into the JS bundle at build time by Vite.
# Set real values in Vercel → frontend project → Environment Variables.
# Never commit .env to git.
# =============================================================================

# Backend API base URL (no trailing slash)
VITE_API_URL=https://your-backend.vercel.app

# AWS S3 base URL for food images (no trailing slash)
VITE_S3_URL=https://your-bucket-name.s3.your-region.amazonaws.com
